{
    "name": "ikay/j-rh",
    "description": "Employee HR module for Laravel (employees, salaries, advances) with an optional Filament admin layer",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Ikay",
            "email": "hi@ikay.tech"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "spatie/laravel-medialibrary": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0|^13.0"
    },
    "suggest": {
        "filament/filament": "^4.0|^5.0 - required only by the optional admin layer (Ikay\\JRh\\JRhPlugin and Ikay\\JRh\\Filament\\**). The Eloquent core does not need it.",
        "barryvdh/laravel-dompdf": "^3.1 - required only by the optional admin layer, for the salary bulletin PDF download."
    },
    "autoload": {
        "psr-4": {
            "Ikay\\JRh\\": "src/",
            "Ikay\\JRh\\Database\\Factories\\": "database/factories/"
        },
        "files": [
            "compat/filament-contracts.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Ikay\\JRh\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ikay\\JRh\\JRhServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
